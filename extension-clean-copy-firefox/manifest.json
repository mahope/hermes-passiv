{
  "manifest_version": 3,
  "name": "Clean Copy MD",
  "version": "1.5.2",
  "description": "Copy any text as clean, formatted Markdown. No more messy pastes — just right-click and copy.",
  "browser_specific_settings": {
    "gecko": {
      "id": "clean-copy-md@mahope.dk",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Clean Copy MD",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "copy-as-markdown": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy selected text as clean Markdown"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
